{
  "name": "quickfix-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "QuickFix Device Care - REST API Server & Real-Time Tracking Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
